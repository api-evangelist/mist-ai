              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Zoom, Teams, Intune Authorization.\n\nRequest Payload, These Field And Values Will Be Specific To Each Of The Third Party Apps Accounts."
        },
        {
          "info": {
            "name": "deleteOrgOauthAppAuthorization",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/setting/:app_name/link_accounts/:account_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "app_name",
                "value": "",
                "type": "path",
                "description": "OAuth application name"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ]
