{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins Orgs EVPN Topologies API",
    "version": "2604.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
