{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins Sites Stats - IoT Endpoints API",
    "version": "2604.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sites Stats - IoT Endpoints",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "searchSiteIotEndpoints",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/sites/:site_id/iotendpoints/search",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "ap_mac",
                "value": "",
                "type": "query",
                "description": "AP MAC address"
              },
              {
                "name": "mac",
                "value": "",
                "type": "query",
                "description": "Device MAC address"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "IoT endpoint type. enum: `zigbee`"
              },
              {
                "name": "mfg",
                "value": "",
                "type": "query",
                "description": "Manufacturer name"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "start",
                "value": "",
                "type": "query",
                "description": "Start time (epoch timestamp in seconds, or relative string like \"-1d\", \"-1w\")"
              },
              {
                "name": "end",
                "value": "",
                "type": "query",
                "description": "End time (epoch timestamp in seconds, or relative string like \"-1d\", \"-2h\", \"now\")"
              },
              {
                "name": "duration",
                "value": "",
                "type": "query",
                "description": "Duration like 7d, 2w"
              }
            ]
          },
          "docs": "Search IoT Endpoints"
        }
      ]
    }
  ],
  "bundled": true
}