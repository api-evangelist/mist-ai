{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins Sites Assets API",
    "version": "2604.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sites Assets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listSiteAssets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/sites/:site_id/assets",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get List of Site Assets"
        },
        {
          "info": {
            "name": "createSiteAsset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/sites/:site_id/assets",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Site Asset"
        },
        {
          "info": {
            "name": "importSiteAssets",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/sites/:site_id/assets/import",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "upsert",
                "value": "",
                "type": "query",
                "description": "API will replace the assets with same mac if provided `upsert`==`True`, otherwise will report in errors in response."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Import Site Assets. \n\nIt can be done via a CSV file or a JSON payload.\n\n## CSV File Format\n```csv\nname,mac\n\"asset_name\",5c5b53010101\n```"
        },
        {
          "info": {
            "name": "getSiteAsset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/sites/:site_id/assets/:asset_id",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "asset_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Site Asset Details"
        },
        {
          "info": {
            "name": "updateSiteAsset",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.mist.com/api/v1/sites/:site_id/assets/:asset_id",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "asset_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Site Asset"
        },
        {
          "info": {
            "name": "deleteSiteAsset",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mist.com/api/v1/sites/:site_id/assets/:asset_id",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "asset_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Site Asset"
        },
        {
          "info": {
            "name": "attachSiteAssetImage",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/sites/:site_id/assets/:asset_id/image",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "asset_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": []
            }
          },
          "docs": "Attach Image to Site Asset"
        },
        {
          "info": {
            "name": "deleteSiteAssetImage",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mist.com/api/v1/sites/:site_id/assets/:asset_id/image",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "asset_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Site Asset Image"
        }
      ]
    }
  ],
  "bundled": true
}