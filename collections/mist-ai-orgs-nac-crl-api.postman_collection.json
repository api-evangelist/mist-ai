        {
          "id": "6a585b57-7d37-4dbe-af99-7b82f917e785",
          "name": "importOrgNacCrl",
          "request": {
            "name": "importOrgNacCrl",
            "description": {
              "content": "The Import NAC Org CRL File endpoint allows users to manually upload a Certificate Revocation List (CRL) file in either PEM or DER format. This is a multipart POST request. We support one file upload per issuer, and re-uploads for the same issuer will overwrite the existing file.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "orgs",
                ":org_id",
                "setting",
                "mist_nac_crls"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "org_id",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "value": "<string>",
                  "type": "text",
                  "description": "a PEM or DER formatted CRL file"
                },
                {
                  "key": "json",
                  "value": "<string>",
                  "type": "text",
                  "description": "a JSON string with \"name\" field for CRL file issuer (optional)"
                }
              ]
            }
          },
