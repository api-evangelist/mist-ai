        {
          "id": "409d44ed-712d-4d58-a340-b83564c6569e",
          "name": "deleteOrgNacCrl",
          "request": {
            "name": "deleteOrgNacCrl",
            "description": {
              "content": "Delete NAC Org CRL file is a DELETE request to delete CRL file identified by its ID (ID assigned on file upload/creation)",
              "type": "text/plain"
