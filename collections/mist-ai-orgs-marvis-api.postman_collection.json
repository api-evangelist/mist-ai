  "item": [
    {
      "id": "cc510046-c006-44ba-9312-e29d7538012c",
      "name": "Orgs Marvis",
      "description": {
        "content": "Marvis is an AI-driven, interactive virtual network assistant that streamlines network operations, simplifies troubleshooting, and provides an enhanced user experience.\nIt offers real-time network visibility, comprehensive insights, and automation customized for your network.\nMarvis can proactively identify issues, interpret their impact, determine root causes, and recommend fixes.\nIt consists of components such as Marvis Actions, Marvis Minis, Conversational Assistant, Marvis Client, and Marvis Query Language.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f6f27edd-d3a4-47ae-890f-6cde22ca8f5c",
          "name": "troubleshootOrg",
          "request": {
            "name": "troubleshootOrg",
            "description": {
              "content": "Troubleshoot sites, devices, clients, and wired clients for maximum of last 7 days from current time. See search APIs for device information:\n- [search Device](/#operations/searchOrgDevices)\n- [search Wireless Client](/#operations/searchOrgWirelessClients)\n- [search Wired Client](/#operations/searchOrgWiredClients)\n- [search Wan Client](/#operations/searchOrgWanClients)\n\n**NOTE**: requires Marvis subscription license",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "orgs",
                ":org_id",
                "troubleshoot"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "mac",
                  "value": "<string>",
                  "description": "**required** when troubleshooting device or a client"
                },
                {
                  "disabled": false,
                  "key": "site_id",
                  "value": "<uuid>",
                  "description": "**required** when troubleshooting site"
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<string>",
                  "description": "Start time (epoch timestamp in seconds, or relative string like \"-1d\", \"-1w\")"
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<string>",
                  "description": "End time (epoch timestamp in seconds, or relative string like \"-1d\", \"-2h\", \"now\")"
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "When troubleshooting site, type of network to troubleshoot"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "org_id",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
