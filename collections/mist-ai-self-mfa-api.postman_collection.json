        {
          "id": "47dd3f0b-17ee-45e6-a3fa-0e6bb0234f46",
          "name": "verifyTwoFactor",
          "request": {
            "name": "verifyTwoFactor",
            "description": {
              "content": "Verify Two-factor (OTP)\n\nTo verify two-factor authentication by using a code generated by app (e.g. Google Authenticator, Authy). Upon successful verification, the `two_factor_passed` will be set to true if it hasn’t already been.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "self",
                "two_factor",
                "verify"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"two_factor\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "5b478a82-4d22-4374-95d0-02cb4629f732",
