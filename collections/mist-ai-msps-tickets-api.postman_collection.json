  "item": [
    {
      "id": "b88c20b3-da77-48e3-837a-a97b54058389",
      "name": "MSPs Tickets",
      "description": {
        "content": "Support tickets are a means for users to seek assistance and resolve issues they encounter with a product or service.\nThey allow users to communicate their problems or questions to the Juniper Mist support team, who can then provide guidance, troubleshooting, or solutions.\nSupport tickets typically include information such as the type of issue, relevant details, and any necessary attachments.\n\nSupport Tickets API Calls at the MSP level can be used to retrieve the tickets for each Organization attached to the MSP account.",
        "type": "text/plain"
      },
