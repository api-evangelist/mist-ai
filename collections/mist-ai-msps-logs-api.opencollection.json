{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins MSPs Logs API",
    "version": "2604.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "MSPs Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listMspAuditLogs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/logs",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "site_id",
                "value": "",
                "type": "query",
                "description": "Site id"
              },
              {
                "name": "admin_name",
                "value": "",
                "type": "query",
                "description": "Admin name or email"
              },
              {
                "name": "message",
                "value": "",
                "type": "query",
                "description": "Message"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sort order"
              },
              {
                "name": "start",
                "value": "",
                "type": "query",
                "description": "Start time (epoch timestamp in seconds, or relative string like \"-1d\", \"-1w\")"
              },
              {
                "name": "end",
                "value": "",
                "type": "query",
                "description": "End time (epoch timestamp in seconds, or relative string like \"-1d\", \"-2h\", \"now\")"
              },
              {
                "name": "duration",
                "value": "",
                "type": "query",
                "description": "Duration like 7d, 2w"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get list of change logs for the current MSP"
        },
        {
          "info": {
            "name": "countMspAuditLogs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/logs/count",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "distinct",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Count by Distinct Attributes of Audit Logs."
        }
      ]
    }
  ],
  "bundled": true
}